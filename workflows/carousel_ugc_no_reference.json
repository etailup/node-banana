      "data": {
        "prompt": "Topic: \"5 Morning Habits That Changed My Life\"\nTone: Warm, authentic, relatable — like talking to a close friend\nSlides: 6 (Hook → Problem → 3 Insights → CTA)"
      },
      "style": {
        "width": 380,
        "height": 160
      },
      "measured": {
